<?xml version="1.0"?>
<package format="3">
  
  <name>quik_ik</name>
  <version>0.1.0</version>
  <description>Inverse Kinematics solver for MoveIt</description>
  <author email="t.ueshiba@aist.go.jp">Toshio Ueshiba</author>
  <maintainer email="t.ueshiba@aist.go.jp">Toshio Ueshiba</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>fmt</depend>
  <depend>generate_parameter_library</depend>
  <depend>moveit_core</depend>
  <depend>pluginlib</depend>
  <depend>range-v3</depend>
  <depend>rclcpp</depend>
  <depend>rsl</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_kdl</depend>
  <depend>libexpected-dev</depend>
  <depend>quik</depend>

  <test_depend>git</test_depend>
  <test_depend>moveit_resources_panda_moveit_config</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <moveit_core plugin="${prefix}/quik_ik_kinematics_description.xml"/>
  </export>
  
</package>
